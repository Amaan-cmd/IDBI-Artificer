{
  "name": "enverai-artificer",
  "version": "1.0.0",
  "description": "EnverAI Artificer - Multi-Agent Alternate-Data Underwriting Citadel",
  "main": "backend/server.js",
  "scripts": {
    "postinstall": "npm install --prefix backend",
    "build": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "smoke-test": "node test_smoke_enterprises.js",
    "deploy:gcloud": "gcloud run deploy enverai-artificer --source . --platform managed --region us-central1 --allow-unauthenticated",
    "test": "node test_smoke_enterprises.js"
  },
  "keywords": [
    "enverai",
    "artificer",
    "multi-agent",
    "underwriting",
    "gemini",
    "vertex-ai"
  ],
  "author": "EnverAI Tech Inc.",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@anthropic-ai/vertex-sdk": "^0.18.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^2.10.0",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "google-auth-library": "^10.9.0",
    "ora": "^5.4.1",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "shadcn": "^4.21.0"
  }
}
