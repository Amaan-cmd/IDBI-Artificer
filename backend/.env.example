# EnverAI Artificer - Backend Environment Configuration Template

# NVIDIA NIM API Key (Optional / Ingestion)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Agent 1 (Fetcha): Grok Engine (xAI API)
GROK_API_KEY=your_xai_or_grok_api_key_here
GROK_MODEL=grok-2-1212

# JEV (System 1 Gatekeeper)
JEV_API_KEY=your_jev_api_key_here
JEV_MODEL=gemini-3.5-flash

# Google Gemini / Vertex AI (Agent 2 Geek & Agent 3 Orc)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=us-central1
# Gemini models (single source: utils/geminiModels.js). gemini-2.5-flash is retired.
GEMINI_FLASH_MODEL=gemini-3.5-flash
# GEMINI_PRO_MODEL=gemini-3.1-pro
# GEMINI_FALLBACK_MODELS=

# Model Selectors
AGENT1_MODEL=grok-4.6
AGENT2_MODEL=gemini-3.5-flash
AGENT3_MODEL=gemini-3.1-pro

# Slack SecOps Webhook Alerts (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Sessions
SESSION_JWT_SECRET=replace-with-a-long-random-string
FIREBASE_PROJECT_ID=idbi-innovate
# Persistent storage (required in production)
AZURE_STORAGE_CONNECTION_STRING=
# Sandbox.co.in registry data
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
# SANDBOX_BASE_URL=https://test-api.sandbox.co.in
# Preset sample companies (labelled SAMPLE DATA)
DEMO_MODE=false
# DEVELOPMENT ONLY: echo email OTP codes in the /auth/send-code response.
# Ignored when NODE_ENV=production and never applied to admin (@enveraitech.com)
# addresses. Never enable in a deployed environment.
# ENABLE_DEMO_OTP=true
