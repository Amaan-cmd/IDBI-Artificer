# EnverAI Artificer Environment Variables Template
PORT=4000

# Google Cloud Vertex AI / Gemini API Credentials
GOOGLE_CLOUD_PROJECT=hii-gemini
GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_API_KEY=your_gemini_api_key_here

# Slack SecOps Webhook Alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional Firebase Admin credentials (if deployed to Google Cloud Functions)
# ENABLE_FIRESTORE=false

# Billing (Stripe Payment Links; webhook signing secret from the Stripe dashboard)
STRIPE_WEBHOOK_SECRET=
STRIPE_LINK_10=
STRIPE_LINK_25=
STRIPE_LINK_100=
